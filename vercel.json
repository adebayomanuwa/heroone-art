{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(fonts|img|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/music/ldcat/credits",
      "destination": "/music/credits/ldcat/",
      "permanent": true
    },
    {
      "source": "/music/ldcat/credits/",
      "destination": "/music/credits/ldcat/",
      "permanent": true
    },
    {
      "source": "/music/highest-currency-gotta-get-it/credits",
      "destination": "/music/credits/highest-currency-gotta-get-it/",
      "permanent": true
    },
    {
      "source": "/music/highest-currency-gotta-get-it/credits/",
      "destination": "/music/credits/highest-currency-gotta-get-it/",
      "permanent": true
    },
    {
      "source": "/music/Hero-One-Press-Release-2026.pdf",
      "destination": "/music/press/Hero-One-Press-Release-2026.pdf",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/#book",
      "permanent": false
    },
    {
      "source": "/magazine",
      "destination": "/gallery/",
      "permanent": true
    },
    {
      "source": "/magazine/",
      "destination": "/gallery/",
      "permanent": true
    }
  ]
}
